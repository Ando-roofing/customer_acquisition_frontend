{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],

    "jsx": "react-jsx",

    "allowJs": true,
    "checkJs": false,

    "strict": false,
    "noEmit": true,

    "module": "ESNext",
    "moduleResolution": "Node",

    "baseUrl": "src",
    "paths": {
      "@styles/*": ["styles/*"],
      "@shared/*": ["shared/*"],
      "@core/*": ["core/*"],
      "@features/*": ["features/*"],
      "@store/*": ["store/*"],
    },

    "isolatedModules": true,
    "skipLibCheck": true,

    "types": ["vite/client"]
  },
  "include": ["src"]
}

